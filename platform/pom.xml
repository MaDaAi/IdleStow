<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.madaai.idlestow</groupId>
    <artifactId>idlestow-parent</artifactId>
    <version>0.1.2</version>
  </parent>
  <artifactId>idlestow-platform</artifactId>
  <name>IdleStow Platform Adapters</name>
  <description>Windows (NTFS via JNA), Linux and macOS implementations of the core platform interfaces.</description>

  <dependencies>
    <dependency><groupId>io.github.madaai.idlestow</groupId><artifactId>idlestow-core</artifactId></dependency>
    <dependency><groupId>net.java.dev.jna</groupId><artifactId>jna-platform</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>

    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-launcher</artifactId><scope>test</scope></dependency>
    <dependency><groupId>ch.qos.logback</groupId><artifactId>logback-classic</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <idlestow.python.dir>${project.basedir}/../python</idlestow.python.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
